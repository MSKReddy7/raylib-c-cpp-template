{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if /I \"${fileExtname}\"==\".c\" (gcc \"${file}\" -o \"${fileBasenameNoExtension}.exe\" -lraylib -lopengl32 -lgdi32 -lwinmm -lshell32 -mwindows -static) else (g++ \"${file}\" -o \"${fileBasenameNoExtension}.exe\" -lraylib -lopengl32 -lgdi32 -lwinmm -lshell32 -mwindows -static) && \"${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Project",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "\"${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}